# ============================================
# LogixPulse — Environment Configuration
# ============================================

# Database Driver: pgsql (PostgreSQL / Supabase) or mysql (Local XAMPP / MariaDB)
DB_CONNECTION=pgsql

# --------------------------------------------
# Option 1: Supabase / PostgreSQL Configuration
# --------------------------------------------
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=logixpulse.bqtnutsmqfuumzcaokwl
DB_PASS=YourSecurePasswordHere
DB_SSLMODE=require

# Full URLs for connection pooling and migrations
DATABASE_URL="postgresql://logixpulse.bqtnutsmqfuumzcaokwl:YourSecurePasswordHere@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://logixpulse.bqtnutsmqfuumzcaokwl:YourSecurePasswordHere@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Public API (for client side widgets / auth)
NEXT_PUBLIC_SUPABASE_URL=https://bqtnutsmqfuumzcaokwl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_oKnCDCtVZb3pfFY2zCfW1Q_9vKsBbKG

# --------------------------------------------
# Option 2: Local MySQL / MariaDB (XAMPP default)
# --------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
