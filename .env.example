# ============================================
# LogixPulse — Environment Configuration
# ============================================

# Database Connection (MySQL / MariaDB via XAMPP or Docker)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logix_pulse
DB_USER=root
DB_PASS=

# Optional: Set to true to force frontend dashboard to use mock data
# without attempting MySQL connection:
DB_MOCK_MODE=false

# Application Settings
APP_ENV=development
APP_URL=http://localhost/
